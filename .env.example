# Neon — copy the pooled connection string from your project dashboard.
# Keep ?sslmode=require. This is a secret: no NEXT_PUBLIC_ prefix, server-only.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Password gate for the deployed app (choose any strong string).
# If this is unset the app is UNPROTECTED — set it before deploying.
APP_PASSWORD=change-me

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-random-string
